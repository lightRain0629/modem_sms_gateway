# HTTP server
PORT=3000

# API key required on every request (x-api-key header or Authorization: Bearer)
# Generate one with: openssl rand -hex 32
API_KEY=change_me_to_a_long_random_string

# Login for the queue dashboard (/admin/queues). Set both or neither;
# when unset, the dashboard falls back to any username + API_KEY as password.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change_me_too

# --- Modems ---------------------------------------------------------------
# Multiple modems: set MODEMS to a JSON array; sends are spread round-robin
# across connected modems (or pinned with the optional "modem" field on
# POST /sms/send). Drivers:
#   serial   — classic USB modem exposing an AT serial port (/dev/ttyUSB*)
#   zte-http — ZTE HiLink/RNDIS sticks (MF823/M100-3...) exposing a web API
#   adb      — Android-based sticks reached over ADB (e.g. UFI003S); sends via
#              Android's SMS service. Inbox read and USSD balance unsupported.
# Per-entry keys: id (required), driver (required); serial:
#   serial   — port, baudRate;
#   zte-http — host, api ("goform" default for MF823/M100-3, "reqproc" for
#              rebadged ZTE-chipset sticks like OLAX U90), password (reqproc
#              builds gate sends behind a web-UI login; defaults to "admin");
#   adb      — serial (adb device id, `adb devices`), adbPath, callingPackage,
#              smsTxnCode (ISms.sendText code; UFI003S = 6, stock AOSP = 5)
#   all      — smsc, ussdBalanceCode (default to the globals below).
# Example:
#   MODEMS=[{"id":"zte","driver":"zte-http","host":"192.168.0.1"},{"id":"ufi","driver":"adb","serial":"32f32221","smsTxnCode":6}]
MODEMS=

# adb driver: path to the adb binary if it isn't on PATH
ADB_PATH=adb

# Single modem (used only when MODEMS is empty; the modem gets id "default"):
MODEM_DRIVER=serial

# serial driver: modem port — find it with: ls /dev/ttyUSB* (Linux) or ls /dev/tty.* (macOS)
USB_PORT=/dev/ttyUSB0
BAUD_RATE=115200

# zte-http driver: the stick's web interface address
ZTE_HOST=192.168.0.1

# Optional: SMS service center number. Leave empty to use the one stored on the SIM.
SMSC=

# USSD code used to check the SIM balance after a send finally fails.
# Quotes are required: dotenv treats an unquoted # as a comment start.
USSD_BALANCE_CODE="*0800#"

# USSD code that makes the carrier SMS back the current tariff plan(s)
# (TMCell: the reply arrives from 0801, one SMS per active tariff)
USSD_TARIFF_CODE="*0805#"

# USSD code that returns the SIM's own phone number
USSD_NUMBER_CODE="*222#"

# Redis (used by the Bull queues). REDIS_DB isolates the gateway's queues
# on a shared Redis (0-15).
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Delivery-status webhooks --------------------------------------------
# The gateway can POST each SMS status transition (sent/failed/unconfirmed,
# and optionally retrying) to a per-send `callbackUrl` on POST /sms/send, so a
# caller learns the status without polling. All optional and additive.
#
# Shared secret used to sign callbacks: header
#   X-Gateway-Signature: sha256=<hex HMAC-SHA256 of "<X-Gateway-Timestamp>.<rawBody>">
# When empty, callbacks are sent UNSIGNED (a startup warning is logged).
# Generate one with: openssl rand -hex 32
WEBHOOK_SIGNING_SECRET=

# Comma-separated allowlist of hostnames a callbackUrl may target, so the
# gateway can't be used as an SSRF relay. Empty = any host (logs a warning).
#   WEBHOOK_ALLOWED_HOSTS=daily.gsr.net,hooks.example.com
WEBHOOK_ALLOWED_HOSTS=

# Fallback callback URL used when a send omits `callbackUrl`. Empty = no
# webhook unless the send supplies one.
WEBHOOK_DEFAULT_URL=

# Send a callback on the intermediate `retrying` state too (noisier). The
# terminal states (sent/failed/unconfirmed) always fire.
WEBHOOK_SEND_INTERMEDIATE=false

# Per-callback HTTP timeout in milliseconds.
WEBHOOK_TIMEOUT_MS=5000
