{
  "openapi": "3.1.0",
  "info": {
    "title": "SMS Gateway",
    "version": "1.0.0",
    "description": "HTTP API that sends and receives SMS through one or more USB GSM modems (serial AT, ZTE HiLink HTTP, or Android/adb drivers). Sends go through a Redis-backed queue with automatic retries; without a pinned `modem`, jobs are spread round-robin across connected modems.\n\n**Message limits** — a message longer than one SMS is sent as a concatenated SMS of up to 3 parts:\n\n| Driver | Charset | 1 part | max (3 parts) |\n|---|---|---|---|\n| serial | GSM-7 (plain Latin) | 160 | 459 (153/part) |\n| serial | UCS2 (e.g. Cyrillic) | 70 | 201 (67/part) |\n| zte-http | always UCS2 | 70 | 201 (67/part) |\n| adb | GSM-7 / UCS2 (auto) | 160 / 70 | 459 / 201 |\n\nWithout a pinned `modem`, the message must fit every configured modem's limits.\n\n**Carrier content filtering** — some operators (observed with TMCell) silently reject messages containing `http`; avoid URLs in message bodies."
  },
  "servers": [{ "url": "/" }],
  "security": [{ "ApiKeyAuth": [] }, { "BearerAuth": [] }],
  "tags": [
    { "name": "Sending", "description": "Queue outbound SMS and track delivery" },
    { "name": "Receiving", "description": "Fetch and browse inbound SMS" },
    { "name": "Monitoring", "description": "Health, metrics and SIM balance" }
  ],
  "paths": {
    "/sms/send": {
      "post": {
        "tags": ["Sending"],
        "summary": "Queue an SMS",
        "description": "Validates the request, persists a `pending` log entry and adds the send to the queue. Returns immediately with `202` — poll `GET /sms/status/{id}` for the delivery result. Failed sends are retried up to 3 times with exponential backoff (10s, 20s, 40s).",
        "operationId": "sendSms",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SendRequest" },
              "example": {
                "to": "+99361234567",
                "message": "Hello, this is a test SMS.",
                "projectName": "E-Center"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "SMS accepted and queued (not yet sent).",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SendResponse" },
                "example": {
                  "success": true,
                  "data": {
                    "message": "SMS queued for sending",
                    "logId": "7edf5906-55c5-4b57-b437-1502167c3ed6"
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/sms/status/{id}": {
      "get": {
        "tags": ["Sending"],
        "summary": "Delivery status of a queued SMS",
        "description": "Returns the delivery-log entry created by `POST /sms/send`. `status` is one of `pending`, `retrying`, `sent`, `failed`, `unconfirmed`. `unconfirmed` means the message was handed to the modem but the confirmation timed out — it is **not** retried (a retry could deliver the SMS twice).",
        "operationId": "getSmsStatus",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The `logId` returned by `POST /sms/send`.",
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "The delivery-log entry.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "const": true },
                    "data": { "$ref": "#/components/schemas/SentMessage" }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": {
            "description": "No log entry with that id.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "success": false, "message": "Log entry not found" }
              }
            }
          },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/sms/sent": {
      "get": {
        "tags": ["Sending"],
        "summary": "Browse the delivery log",
        "description": "Sent/failed/pending outbound messages, newest first. `total` is the count matching the filters.",
        "operationId": "listSent",
        "parameters": [
          { "$ref": "#/components/parameters/Limit" },
          { "$ref": "#/components/parameters/Offset" },
          {
            "name": "status",
            "in": "query",
            "description": "Exact-match filter on delivery status.",
            "schema": { "$ref": "#/components/schemas/DeliveryStatus" }
          },
          {
            "name": "projectName",
            "in": "query",
            "description": "Exact-match filter on the sending project.",
            "schema": { "type": "string" }
          },
          {
            "name": "to",
            "in": "query",
            "description": "Exact-match filter on the recipient number.",
            "schema": { "type": "string" }
          },
          { "$ref": "#/components/parameters/ModemFilter" }
        ],
        "responses": {
          "200": {
            "description": "A page of the delivery log.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "const": true },
                    "data": {
                      "type": "object",
                      "properties": {
                        "messages": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/SentMessage" }
                        },
                        "total": { "type": "integer", "description": "Count matching the filters." },
                        "limit": { "type": "integer" },
                        "offset": { "type": "integer" }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/sms/messages": {
      "get": {
        "tags": ["Receiving"],
        "summary": "Fetch new messages from the modems",
        "description": "Reads all SMS stored on every modem's SIM/device (or one modem with `?modem=`), **saves them to the database**, then deletes only the messages that were read (a message arriving during the read is kept for next time; if the DB write fails, nothing is deleted).\n\nIf some (but not all) modems fail to answer, the reply additionally carries `data.errors` alongside the messages from the healthy ones; when every modem fails, the endpoint returns `500`. No-op for `adb` modems (their shell lacks SMS read access).",
        "operationId": "fetchMessages",
        "parameters": [{ "$ref": "#/components/parameters/ModemFilter" }],
        "responses": {
          "200": {
            "description": "Messages read from the modems (already persisted to the database).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "const": true },
                    "data": {
                      "type": "object",
                      "properties": {
                        "messages": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/ModemMessage" }
                        },
                        "errors": {
                          "type": "array",
                          "description": "Present when some (but not all) modems failed to answer.",
                          "items": { "$ref": "#/components/schemas/ModemError" }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": {
                    "messages": [
                      {
                        "status": "REC UNREAD",
                        "from": "+99361234567",
                        "date": "26/07/06,12:30:00+20",
                        "text": "Hi",
                        "modemId": "zte"
                      }
                    ]
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/UnknownModem" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": {
            "description": "Every modem failed to answer.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/Error" },
                    {
                      "type": "object",
                      "properties": {
                        "errors": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/ModemError" }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/sms/inbox": {
      "get": {
        "tags": ["Receiving"],
        "summary": "Browse stored received messages",
        "description": "Inbound messages previously fetched by `GET /sms/messages`, newest first.",
        "operationId": "listInbox",
        "parameters": [
          { "$ref": "#/components/parameters/Limit" },
          { "$ref": "#/components/parameters/Offset" },
          { "$ref": "#/components/parameters/ModemFilter" },
          {
            "name": "from",
            "in": "query",
            "description": "Exact-match filter on the sender number (e.g. `0801` for the carrier's tariff SMS).",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of the inbox.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "const": true },
                    "data": {
                      "type": "object",
                      "properties": {
                        "messages": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/InboxMessage" }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/sms/balance": {
      "get": {
        "tags": ["Monitoring"],
        "summary": "SIM balance (last known, or live via USSD)",
        "description": "By default returns the newest **persisted** balance per modem (with `checkedAt`) from the USSD request history — instant, no modem interaction. With `?live=true` it runs the USSD balance code right now instead and persists the result: **slow** (a USSD round-trip takes 20–30 s per modem, queried in parallel) and it holds the modem lock — queued sends wait until it finishes. Unsupported on `adb` modems.",
        "operationId": "getBalance",
        "parameters": [
          { "$ref": "#/components/parameters/ModemFilter" },
          {
            "name": "live",
            "in": "query",
            "description": "`true`/`1`: run the USSD session now instead of reading the stored value.",
            "schema": { "type": "boolean", "default": false }
          }
        ],
        "responses": {
          "200": {
            "description": "Per-modem balances. A modem with no answer carries `balance: null` and an `error`.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "const": true },
                    "data": {
                      "type": "object",
                      "properties": {
                        "balances": {
                          "type": "object",
                          "description": "Keyed by modem id.",
                          "additionalProperties": { "$ref": "#/components/schemas/BalanceResult" }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": {
                    "balances": {
                      "zte": {
                        "balance": "Balans: 5.20 TMT",
                        "checkedAt": "2026-07-08T10:00:30.000Z",
                        "requestId": "b2f0a1de-8c1a-4a86-9f0e-2d5c1f7f4c11"
                      },
                      "ufi": { "balance": null, "error": "USSD is not supported on the adb driver" }
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/UnknownModem" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/sms/balance/refresh": {
      "post": {
        "tags": ["Monitoring"],
        "summary": "Queue a balance USSD check",
        "description": "Queues the USSD balance code on every USSD-capable modem (or one modem with `?modem=`) and returns immediately with one request id per modem. Poll `GET /sms/ussd/{id}` for the outcome; once `done`, `GET /sms/balance` serves the new value. Failed sessions are retried once after 15 s (retrying a silent USSD is safe — nothing is delivered twice).",
        "operationId": "refreshBalance",
        "parameters": [{ "$ref": "#/components/parameters/ModemFilter" }],
        "responses": {
          "202": { "$ref": "#/components/responses/UssdQueued" },
          "400": { "$ref": "#/components/responses/UnknownModem" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/sms/tariff/refresh": {
      "post": {
        "tags": ["Monitoring"],
        "summary": "Queue a tariff USSD request",
        "description": "Queues the USSD tariff code (default `*0805#`) on every USSD-capable modem (or one modem with `?modem=`). The USSD reply itself is only an acknowledgment — the carrier sends the actual plan details **as SMS** a little later (TMCell: from `0801`, one SMS per active tariff). After the session completes, the gateway sweeps the modem's inbox at +30 s / +90 s / +180 s so those SMS land in the database; read them with `GET /sms/inbox?from=0801`.",
        "operationId": "refreshTariff",
        "parameters": [{ "$ref": "#/components/parameters/ModemFilter" }],
        "responses": {
          "202": { "$ref": "#/components/responses/UssdQueued" },
          "400": { "$ref": "#/components/responses/UnknownModem" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/sms/number": {
      "get": {
        "tags": ["Monitoring"],
        "summary": "The SIM's own phone number (last known, or live via USSD)",
        "description": "Same pattern as `/sms/balance`: returns the newest persisted `USSD_NUMBER_CODE` (default `*222#`) reply per modem, or runs the session now with `?live=true`. Useful when the SIM in a modem is unlabeled. Unsupported on `adb` modems.",
        "operationId": "getNumber",
        "parameters": [
          { "$ref": "#/components/parameters/ModemFilter" },
          {
            "name": "live",
            "in": "query",
            "description": "`true`/`1`: run the USSD session now instead of reading the stored value.",
            "schema": { "type": "boolean", "default": false }
          }
        ],
        "responses": {
          "200": {
            "description": "Per-modem numbers. A modem with no answer carries `number: null` and an `error`.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "const": true },
                    "data": {
                      "type": "object",
                      "properties": {
                        "numbers": {
                          "type": "object",
                          "description": "Keyed by modem id.",
                          "additionalProperties": { "$ref": "#/components/schemas/NumberResult" }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": {
                    "numbers": {
                      "zte": {
                        "number": "993XXXXXXXX",
                        "checkedAt": "2026-07-08T10:05:00.000Z",
                        "requestId": "c3d1b2ef-0a4b-4d2c-8e77-1f9a6b3c5d21"
                      },
                      "ufi": { "number": null, "error": "USSD is not supported on the adb driver" }
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/UnknownModem" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/sms/number/refresh": {
      "post": {
        "tags": ["Monitoring"],
        "summary": "Queue an own-number USSD check",
        "description": "Queues the `USSD_NUMBER_CODE` session on every USSD-capable modem (or one modem with `?modem=`). Poll `GET /sms/ussd/{id}` for the outcome; once `done`, `GET /sms/number` serves the value.",
        "operationId": "refreshNumber",
        "parameters": [{ "$ref": "#/components/parameters/ModemFilter" }],
        "responses": {
          "202": { "$ref": "#/components/responses/UssdQueued" },
          "400": { "$ref": "#/components/responses/UnknownModem" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/sms/ussd": {
      "get": {
        "tags": ["Monitoring"],
        "summary": "Browse the USSD request history",
        "description": "Every USSD session ever run — queued refreshes, `?live=true` checks and the automatic post-failure balance checks — newest first. Balance history over time lives here.",
        "operationId": "listUssdRequests",
        "parameters": [
          { "$ref": "#/components/parameters/Limit" },
          { "$ref": "#/components/parameters/Offset" },
          {
            "name": "kind",
            "in": "query",
            "description": "Exact-match filter on the request kind.",
            "schema": { "$ref": "#/components/schemas/UssdKind" }
          },
          { "$ref": "#/components/parameters/ModemFilter" }
        ],
        "responses": {
          "200": {
            "description": "A page of USSD requests.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "const": true },
                    "data": {
                      "type": "object",
                      "properties": {
                        "requests": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/UssdRequest" }
                        },
                        "total": { "type": "integer", "description": "Count matching the filters." }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/sms/ussd/{id}": {
      "get": {
        "tags": ["Monitoring"],
        "summary": "Status of one USSD request",
        "description": "Returns the request created by a refresh endpoint. `status` is `pending` until the session completes, then `done` (with `reply`) or `failed` (with `error`).",
        "operationId": "getUssdRequest",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "A request id returned by a refresh endpoint.",
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "The USSD request.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "const": true },
                    "data": { "$ref": "#/components/schemas/UssdRequest" }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": {
            "description": "No USSD request with that id.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "success": false, "message": "USSD request not found" }
              }
            }
          },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/sms/metrics": {
      "get": {
        "tags": ["Monitoring"],
        "summary": "Delivery counters",
        "description": "All-time and last-24h outbound totals, broken down by delivery status.",
        "operationId": "getMetrics",
        "responses": {
          "200": {
            "description": "Delivery counters.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "const": true },
                    "data": {
                      "type": "object",
                      "properties": {
                        "total": { "type": "integer" },
                        "byStatus": { "$ref": "#/components/schemas/StatusCounts" },
                        "last24h": {
                          "type": "object",
                          "properties": {
                            "total": { "type": "integer" },
                            "byStatus": { "$ref": "#/components/schemas/StatusCounts" }
                          }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": {
                    "total": 128,
                    "byStatus": { "sent": 120, "failed": 5, "unconfirmed": 1, "pending": 2 },
                    "last24h": { "total": 12, "byStatus": { "sent": 11, "failed": 1 } }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/sms/health": {
      "get": {
        "tags": ["Monitoring"],
        "summary": "Health check",
        "description": "Probes every modem (an `AT` command on serial, a status query on zte-http). **Always returns `200`** — the API can still queue sends while modems reconnect — with the per-modem state in the body. Monitors should key on `data.modems`, not the HTTP code. The legacy `data.modem` field stays for older single-modem monitors: `connected` while at least one modem is up.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Gateway and per-modem status.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "const": true },
                    "data": {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "string",
                          "enum": ["ok", "degraded"],
                          "description": "`ok` only when every modem is up."
                        },
                        "modem": {
                          "type": "string",
                          "enum": ["connected", "unavailable"],
                          "description": "Legacy single-modem field: `connected` while at least one modem is up."
                        },
                        "modems": {
                          "type": "object",
                          "description": "Per-modem state, keyed by modem id.",
                          "additionalProperties": { "type": "string", "enum": ["connected", "unavailable"] }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": {
                    "status": "ok",
                    "modem": "connected",
                    "modems": { "zte": "connected", "ufi": "connected" }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "The gateway's `API_KEY`."
      },
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "The gateway's `API_KEY` as a bearer token."
      }
    },
    "parameters": {
      "Limit": {
        "name": "limit",
        "in": "query",
        "description": "Page size (clamped to 1–500).",
        "schema": { "type": "integer", "default": 50, "minimum": 1, "maximum": 500 }
      },
      "Offset": {
        "name": "offset",
        "in": "query",
        "description": "Rows to skip.",
        "schema": { "type": "integer", "default": 0, "minimum": 0 }
      },
      "ModemFilter": {
        "name": "modem",
        "in": "query",
        "description": "Restrict to one modem by id.",
        "schema": { "type": "string" }
      }
    },
    "schemas": {
      "DeliveryStatus": {
        "type": "string",
        "enum": ["pending", "retrying", "sent", "failed", "unconfirmed"],
        "description": "`pending` → queued; `retrying` → a send attempt failed, another is scheduled; `sent` → confirmed by the modem; `failed` → all attempts exhausted; `unconfirmed` → handed to the modem but the confirmation timed out (not retried — the SMS may already be delivered)."
      },
      "SendRequest": {
        "type": "object",
        "required": ["to", "message", "projectName"],
        "properties": {
          "to": {
            "type": "string",
            "pattern": "^\\+?[0-9]{7,15}$",
            "description": "Recipient in international format: 7–15 digits, optional leading `+`.",
            "examples": ["+99361234567"]
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "description": "Message body. Longer than one SMS → concatenated SMS of up to 3 parts (see the length table in the API description). Control characters other than newline are rejected."
          },
          "projectName": {
            "type": "string",
            "minLength": 1,
            "description": "Calling project's name, stored in the delivery log."
          },
          "modem": {
            "type": "string",
            "description": "Optional modem id; pins the send to that modem instead of round-robin."
          }
        }
      },
      "SendResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "const": true },
          "data": {
            "type": "object",
            "properties": {
              "message": { "type": "string" },
              "logId": {
                "type": "string",
                "format": "uuid",
                "description": "Use with `GET /sms/status/{id}` to track delivery."
              }
            }
          }
        }
      },
      "SentMessage": {
        "type": "object",
        "description": "A delivery-log entry.",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "timestamp": { "type": "string", "format": "date-time", "description": "When the send was queued." },
          "to": { "type": "string" },
          "message": { "type": "string" },
          "projectName": { "type": "string" },
          "ip": { "type": ["string", "null"], "description": "Client IP that queued the send." },
          "status": { "$ref": "#/components/schemas/DeliveryStatus" },
          "sentAt": { "type": ["string", "null"], "format": "date-time" },
          "reference": {
            "type": ["string", "null"],
            "description": "Modem's send reference (e.g. `+CMGS: 12` on serial)."
          },
          "modemId": {
            "type": ["string", "null"],
            "description": "The modem that carried (or last attempted) the message; `null` while the send is still pending on a round-robin job."
          },
          "error": { "type": ["string", "null"], "description": "Last modem error on `retrying`/`failed`." }
        },
        "example": {
          "id": "7edf5906-55c5-4b57-b437-1502167c3ed6",
          "timestamp": "2026-07-06T10:00:00.000Z",
          "to": "+99361234567",
          "message": "Hello",
          "projectName": "E-Center",
          "ip": "::1",
          "status": "sent",
          "sentAt": "2026-07-06T10:00:04.000Z",
          "reference": "+CMGS: 12",
          "modemId": "zte",
          "error": null
        }
      },
      "ModemMessage": {
        "type": "object",
        "description": "A message as read from a modem's SIM/device storage.",
        "properties": {
          "status": { "type": "string", "description": "Modem-side read state, e.g. `REC UNREAD`." },
          "from": { "type": "string" },
          "date": { "type": "string", "description": "Modem-format timestamp, e.g. `26/07/06,12:30:00+20`." },
          "text": { "type": "string" },
          "modemId": { "type": "string" }
        }
      },
      "InboxMessage": {
        "type": "object",
        "description": "A received message persisted in the database.",
        "properties": {
          "id": { "type": "integer" },
          "from": { "type": ["string", "null"] },
          "date": { "type": ["string", "null"], "description": "Modem-format timestamp." },
          "text": { "type": "string" },
          "receivedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the gateway stored the message."
          },
          "modemId": { "type": ["string", "null"] }
        }
      },
      "BalanceResult": {
        "type": "object",
        "properties": {
          "balance": { "type": ["string", "null"], "description": "Raw USSD reply, `null` when none is available." },
          "checkedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the balance was read from the SIM (may be old — refresh to update)."
          },
          "requestId": {
            "type": "string",
            "format": "uuid",
            "description": "The underlying USSD request (see `GET /sms/ussd/{id}`)."
          },
          "error": { "type": "string", "description": "Present when no balance is available." }
        }
      },
      "UssdKind": {
        "type": "string",
        "enum": ["balance", "tariff", "number"],
        "description": "`balance` — the reply itself carries the balance; `tariff` — the reply only acknowledges, the plan details arrive as SMS; `number` — the reply carries the SIM's own phone number."
      },
      "NumberResult": {
        "type": "object",
        "properties": {
          "number": { "type": ["string", "null"], "description": "Raw USSD reply, `null` when none is available." },
          "checkedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the number was read from the SIM."
          },
          "requestId": {
            "type": "string",
            "format": "uuid",
            "description": "The underlying USSD request (see `GET /sms/ussd/{id}`)."
          },
          "error": { "type": "string", "description": "Present when no number is available." }
        }
      },
      "UssdRequest": {
        "type": "object",
        "description": "One persisted USSD session.",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "modemId": { "type": "string" },
          "kind": { "$ref": "#/components/schemas/UssdKind" },
          "code": { "type": "string", "description": "The USSD code that was (or will be) dialed." },
          "status": {
            "type": "string",
            "enum": ["pending", "done", "failed"],
            "description": "`pending` → queued or running; `done` → replied; `failed` → all attempts exhausted."
          },
          "reply": { "type": ["string", "null"], "description": "Raw USSD reply once `done`." },
          "error": { "type": ["string", "null"], "description": "Last error once `failed`." },
          "requestedAt": { "type": "string", "format": "date-time" },
          "completedAt": { "type": ["string", "null"], "format": "date-time" }
        },
        "example": {
          "id": "b2f0a1de-8c1a-4a86-9f0e-2d5c1f7f4c11",
          "modemId": "zte",
          "kind": "balance",
          "code": "*0800#",
          "status": "done",
          "reply": "Balans: 5.20 TMT",
          "error": null,
          "requestedAt": "2026-07-08T10:00:00.000Z",
          "completedAt": "2026-07-08T10:00:30.000Z"
        }
      },
      "ModemError": {
        "type": "object",
        "properties": {
          "modem": { "type": "string" },
          "error": { "type": "string" }
        }
      },
      "StatusCounts": {
        "type": "object",
        "description": "Message counts keyed by delivery status; absent statuses have no messages.",
        "additionalProperties": { "type": "integer" }
      },
      "Error": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "const": false },
          "message": { "type": "string" }
        }
      }
    },
    "responses": {
      "ValidationError": {
        "description": "Invalid request body.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "example": {
              "success": false,
              "message": "to must be a phone number in international format, e.g. +99361234567"
            }
          }
        }
      },
      "UssdQueued": {
        "description": "USSD sessions queued, one request per targeted modem.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "success": { "type": "boolean", "const": true },
                "data": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" },
                    "requests": {
                      "type": "object",
                      "description": "Request id per modem id — poll `GET /sms/ussd/{id}`.",
                      "additionalProperties": { "type": "string", "format": "uuid" }
                    }
                  }
                }
              }
            },
            "example": {
              "success": true,
              "data": {
                "message": "balance USSD queued",
                "requests": { "zte": "b2f0a1de-8c1a-4a86-9f0e-2d5c1f7f4c11" }
              }
            }
          }
        }
      },
      "UnknownModem": {
        "description": "The `modem` query parameter names a modem that is not configured.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "example": { "success": false, "message": "Unknown modem \"foo\" — available: zte, ufi" }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing or invalid API key.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "example": { "success": false, "message": "Unauthorized" }
          }
        }
      },
      "ServerError": {
        "description": "Unexpected server error.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      }
    }
  }
}
